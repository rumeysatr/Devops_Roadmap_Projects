# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# Then source it (or use ./run.sh) before running terraform / ansible.

# --- Terraform inputs (auto-read through the TF_VAR_ prefix) ---
TF_VAR_aws_region=eu-central-1
TF_VAR_instance_type=t3.micro

# Absolute path to the PUBLIC key registered as an AWS key pair
TF_VAR_public_key_path=

# Your public IP in CIDR notation (find it with: curl ifconfig.me)
TF_VAR_allowed_ssh_cidr=

# --- Ansible connection (read via lookup('env', ...) in ansible/group_vars/all.yml) ---
# EC2 public IP (run: terraform output public_ip)
SERVER_IP=
SSH_USER=ubuntu

# Absolute path to the matching PRIVATE key
SSH_KEY_PATH=
