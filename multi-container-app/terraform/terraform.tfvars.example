# Kopyala: cp terraform.tfvars.example terraform.tfvars  (gerçek dosya gitignore'da)
aws_region = "eu-central-1"
instance_type = "t3.micro"
public_key_path = "~/.ssh/todo-app-ec2-key.pub"
# Sadece kendi IP'ne izin ver: https://checkip.amazonaws.com ile öğren, /32 ekle
ssh_allowed_cidr = "0.0.0.0/0"
